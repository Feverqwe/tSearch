{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": false,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["chrome", "node"],
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noUnusedLocals": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".storybook/**/*.ts",
    "test/**/*.ts",
    "tools/**/*.ts",
    "playwright.config.ts",
    "builder/**/*.ts",
    "rspack.config.ts",
    "eslint.config.ts"
  ]
}
