{
  "name": "tms",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^24.11.0",
    "npm": "^11.0.0"
  },
  "scripts": {
    "build": "rspack build --mode development",
    "watch": "rspack build --mode development --watch",
    "buildRelease": "rspack build --mode production",
    "buildExplorersJson": "node builder/build-catalog.ts explorers",
    "buildTrackersJson": "node builder/build-catalog.ts trackers",
    "compress": "node builder/compress-dist.ts",
    "release": "npm run buildExplorersJson && npm run buildTrackersJson && npm run buildRelease && npm run compress",
    "lint": "eslint --flag unstable_native_nodejs_ts_config . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check rspack.config.ts eslint.config.ts builder \"test/**/*.{ts,tsx}\" package.json .prettierrc.json tsconfig.json playwright.config.ts .storybook \"src/**/*.{ts,tsx}\" \"packages/**/*.ts\"",
    "format:fix": "prettier --write rspack.config.ts eslint.config.ts builder \"test/**/*.{ts,tsx}\" package.json .prettierrc.json tsconfig.json playwright.config.ts .storybook \"src/**/*.{ts,tsx}\" \"packages/**/*.ts\"",
    "test": "npm run buildRelease && npm run compress && node --test test/*.test.ts \"src/**/__tests__/*.test.ts\" \"packages/**/__tests__/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format && npm test",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open --no-version-updates",
    "build-storybook": "storybook build",
    "test:browser": "npm run buildRelease && playwright test",
    "browser:live": "npm run buildRelease && node test/live/open.ts",
    "test:browser:live": "npm run buildRelease && playwright test -c test/live/playwright.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/dom": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@eslint-community/regexpp": "^4.12.3",
    "@floating-ui/react-dom": "^2.1.9",
    "@tanstack/react-query": "^5.107.1",
    "codemirror": "^6.0.2",
    "compare-versions": "^6.1.1",
    "content-type": "^3.1.1",
    "date-fns": "^4.4.0",
    "fecha": "^4.2.3",
    "filesize": "^11.0.32",
    "filesize-parser": "^1.5.2",
    "jszip": "^3.10.2",
    "lodash.debounce": "^4.0.8",
    "lodash.escaperegexp": "^4.1.2",
    "lodash.uniq": "^4.5.0",
    "mobx": "^7.1.7",
    "mobx-react-lite": "^5.1.3",
    "moment": "^2.31.0",
    "parse5": "^8.1.1",
    "querystring-es3": "^0.2.1",
    "react": "^19.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.1",
    "react-resizable": "^4.0.2",
    "react-resizable-panels": "^4.24.0",
    "react-router-dom": "^7.18.5",
    "requires-port": "^1.0.0",
    "serialize-error": "^13.1.0",
    "sizzle": "^2.3.10"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@rspack/cli": "^2.3.2",
    "@rspack/core": "^2.3.2",
    "@storybook/react-vite": "^10.6.7",
    "@types/chrome": "^0.3.7",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.escaperegexp": "^4.1.9",
    "@types/lodash.uniq": "^4.5.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/requires-port": "^1.0.3",
    "@types/sizzle": "^2.3.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "less": "^4.9.1",
    "less-loader": "^13.1.0",
    "prettier": "^3.10.1",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "type": "module"
}
