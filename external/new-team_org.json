{
  "version": 3,
  "type": "kit",
  "description": {
    "icon": "data:image/png;base64,%3D%3D",
    "name": "New-Team.Org",
    "url": "https://new-team.org/",
    "version": "1.2",
    "requestMode": "tab"
  },
  "search": {
    "url": "https://new-team.org/tracker.php",
    "method": "POST",
    "body": "max=1&to=1&nm=%search%"
  },
  "auth": {
    "url": "https://new-team.org/login.php",
    "loginForm": { "selector": "form[action='./login.php'] input[name='login_password']" }
  },
  "selectors": {
    "row": { "selector": "#tor-tbl > tbody > tr:has(> td a[href^='/viewtopic.php?t='])" },
    "categoryTitle": {
      "selector": "td > a[href^='tracker.php?f=']",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }]
    },
    "categoryUrl": {
      "selector": "td > a[href^='tracker.php?f=']",
      "pipeline": [{ "name": "getAttr", "args": ["href"] }]
    },
    "title": {
      "selector": "td a[href^='/viewtopic.php?t=']",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }]
    },
    "url": {
      "selector": "td a[href^='/viewtopic.php?t=']",
      "pipeline": [{ "name": "getAttr", "args": ["href"] }]
    },
    "size": {
      "selector": "td:has(> a[href^='/download.php?id=']) > u",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }, { "name": "toInt" }]
    },
    "downloadUrl": {
      "selector": "td > a[href^='/download.php?id=']",
      "pipeline": [{ "name": "getAttr", "args": ["href"] }]
    },
    "seeds": {
      "selector": "td.seedmed",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }]
    },
    "peers": {
      "selector": "td.leechmed",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }]
    },
    "date": {
      "selector": "td:last-child > u",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }, { "name": "toInt" }]
    },
    "nextPageUrl": {
      "selector": "b + a[href^='tracker.php?search_id='][href*='&start=']",
      "pipeline": [{ "name": "getProp", "args": ["href"] }]
    }
  }
}
