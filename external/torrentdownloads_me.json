{
  "version": 3,
  "type": "kit",
  "description": {
    "icon": "data:image/x-icon;base64,%3D",
    "name": "Torrent Downloads",
    "url": "https://www.torrentdownloads.pro/search/",
    "version": "1.1"
  },
  "search": {
    "url": "https://www.torrentdownloads.pro/search/?search=%search%",
    "method": "GET"
  },
  "selectors": {
    "row": { "selector": "div.inner_container > div:has(> p > a[href^=\"/torrent/\"])" },
    "title": {
      "selector": ":scope > p:nth-of-type(1) > a[href^=\"/torrent/\"]",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }]
    },
    "url": {
      "selector": ":scope > p:nth-of-type(1) > a[href^=\"/torrent/\"]",
      "pipeline": [{ "name": "getProp", "args": ["href"] }]
    },
    "size": {
      "selector": ":scope > span:nth-of-type(4)",
      "pipeline": [
        { "name": "getText" },
        { "name": "trim" },
        { "name": "replaceRe", "args": ["^[\\s\\S]*?(\\d[\\d., ]*\\s*(?:[kmgt]i?b|[кмгт]б))[\\s\\S]*$", "$1"] },
        { "name": "legacySizeFormat" }
      ]
    },
    "seeds": {
      "selector": ":scope > span:nth-of-type(3)",
      "pipeline": [
        { "name": "getText" },
        { "name": "trim" },
        { "name": "toInt" }
      ]
    },
    "peers": {
      "selector": ":scope > span:nth-of-type(2)",
      "pipeline": [
        { "name": "getText" },
        { "name": "trim" },
        { "name": "toInt" }
      ]
    }
  }
}
