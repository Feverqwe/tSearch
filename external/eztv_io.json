{
  "version": 3,
  "type": "kit",
  "description": {
    "icon": "data:image/png;base64,",
    "name": "EZTV",
    "url": "https://eztvx.to/",
    "description": "EZTV, your one stop source for all your favorite TV shows.",
    "version": "1.1",
    "requestMode": "tab"
  },
  "search": { "url": "https://eztvx.to/search/%search%", "method": "GET" },
  "selectors": {
    "row": { "selector": "tr:has(td > a[href^='/ep/'])" },
    "title": {
      "selector": "td > a[href^='/ep/']",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }]
    },
    "url": {
      "selector": "td > a[href^='/ep/']",
      "pipeline": [{ "name": "getAttr", "args": ["href"] }]
    },
    "size": {
      "selector": "td:nth-last-child(3)",
      "pipeline": [
        { "name": "getText" },
        { "name": "trim" },
        { "name": "legacySizeFormat" }
      ]
    },
    "downloadUrl": {
      "selector": "td > a[href^='magnet:']",
      "pipeline": [{ "name": "getAttr", "args": ["href"] }]
    },
    "seeds": {
      "selector": "td:last-child",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }, { "name": "toInt" }]
    }
  }
}
