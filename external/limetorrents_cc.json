{
  "version": 3,
  "type": "kit",
  "description": {
    "icon": "data:image/png;base64,",
    "name": "LimeTorrents",
    "url": "https://limetorrents.eu/",
    "version": "1.1"
  },
  "search": {
    "url": "https://limetorrents.eu/search?q=%search%",
    "method": "GET"
  },
  "selectors": {
    "row": { "selector": "table.table2 > tbody > tr:has(a[href^='/torrent/'])" },
    "title": {
      "selector": "a[href^='/torrent/']",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }]
    },
    "url": {
      "selector": "a[href^='/torrent/']",
      "pipeline": [{ "name": "getAttr", "args": ["href"] }]
    },
    "size": {
      "selector": "td.tdnormal:eq(1)",
      "pipeline": [
        { "name": "getText" },
        { "name": "trim" },
        { "name": "legacySizeFormat" }
      ]
    },
    "downloadUrl": {
      "selector": "a[href^='/download/torrent/']",
      "pipeline": [{ "name": "getAttr", "args": ["href"] }]
    },
    "seeds": {
      "selector": "td.tdseed",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }]
    },
    "peers": {
      "selector": "td.tdleech",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }]
    }
  }
}
