{
  "version": 3,
  "type": "kit",
  "description": {
    "icon": "#3d04b8",
    "name": "abook-club.ru",
    "url": "http://torrent.abook-club.ru/",
    "description": "Трекер Клуба Любителей Аудиокниг",
    "version": "1.1"
  },
  "search": {
    "url": "http://torrent.abook-club.ru/browse.php?incldead=0&search=%search%",
    "method": "GET",
    "encoding": "cp1251"
  },
  "auth": {
    "url": "http://torrent.abook-club.ru/login.php",
    "loginForm": {
      "selector": "form[action=\"takelogin.php\"] input[name=\"username\"]"
    }
  },
  "selectors": {
    "row": {
      "selector": "tr:has(> td > a[href^='browse.php?cat='] > img):has(> td table a[href^='details.php?id='])"
    },
    "categoryTitle": {
      "selector": "td > a[href^='browse.php?cat='] > img",
      "pipeline": [{ "name": "getAttr", "args": ["alt"] }]
    },
    "categoryUrl": {
      "selector": "td > a[href^='browse.php?cat=']",
      "pipeline": [{ "name": "getAttr", "args": ["href"] }]
    },
    "title": {
      "selector": "td table a[href^='details.php?id=']",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }]
    },
    "url": {
      "selector": "td table a[href^='details.php?id=']",
      "pipeline": [{ "name": "getAttr", "args": ["href"] }]
    },
    "size": {
      "selector": ":scope > td:nth-last-child(4)",
      "pipeline": [
        { "name": "getText" },
        { "name": "trim" },
        { "name": "legacySizeFormat" }
      ]
    },
    "seeds": {
      "selector": ":scope > td:nth-last-child(3)",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }]
    },
    "peers": {
      "selector": ":scope > td:nth-last-child(2)",
      "pipeline": [{ "name": "getText" }, { "name": "trim" }]
    },
    "date": {
      "selector": "td > nobr",
      "pipeline": [
        { "name": "getText" },
        { "name": "trim" },
        { "name": "replaceRe", "args": ["(.{10})(.+)", "$1 $2"] },
        { "name": "legacyParseDate", "args": [0] }
      ]
    },
    "nextPageUrl": {
      "selector": "p > br ~ b + a[href^='browse.php?search='][href*='&page=']",
      "pipeline": [
        { "name": "getAttr", "args": ["href"] },
        { "name": "replaceRe", "args": ["^([^?]+\\?search=[^&]*.*?)&search=[^&]*", "$1"] }
      ]
    }
  }
}
