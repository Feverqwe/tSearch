{
  "manifest_version": 3,
  "minimum_chrome_version": "156",
  "icons": {
    "128": "assets/icons/icon_128.png",
    "48": "assets/icons/icon_48.png",
    "16": "assets/icons/icon_16.png"
  },
  "options_page": "index.html#/options",
  "permissions": [
    "storage",
    "contextMenus",
    "unlimitedStorage",
    "scripting"
  ],
  "omnibox": {
    "keyword": "tms"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self';",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'; img-src data:;"
  },
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "version": "4.0.0",
  "action": {
    "default_icon": {
      "19": "assets/icons/icon_19.png",
      "38": "assets/icons/icon_38.png"
    },
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
